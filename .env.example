# Copy to .env and fill in at least ONE key. .env is git-ignored.
# Which provider the app uses by default: anthropic | openai | gemini | xai | ollama
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Ollama (local, no key). Leave empty to disable; start it with `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional model overrides (defaults live in src/toptal/config.py)
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=
# GEMINI_MODEL=
# XAI_MODEL=
# OLLAMA_MODEL=qwen2.5:7b-instruct

LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
